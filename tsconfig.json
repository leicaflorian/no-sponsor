{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "tests", "scripts", "*.config.ts", "*.config.js", ".wxt/wxt.d.ts"],
  "exclude": ["node_modules", ".output", "tests/fixtures"]
}
